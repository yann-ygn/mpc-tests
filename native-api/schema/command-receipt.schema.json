{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native command receipt",
  "type": "object",
  "required": [
    "apiVersion",
    "requestId",
    "instanceId",
    "status",
    "execution",
    "target",
    "op",
    "value",
    "changed",
    "nativeInvoked",
    "verification",
    "observedChanges",
    "error",
    "timing"
  ],
  "properties": {
    "apiVersion": {
      "const": "0.1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "instanceId": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{32}$"
    },
    "status": {
      "enum": [
        "accepted",
        "applied",
        "rejected",
        "cancelled",
        "unknown"
      ]
    },
    "execution": {
      "enum": [
        "not_started",
        "started",
        "completed"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "instanceId",
        "projectId",
        "trackId"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "trackId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "additionalProperties": false
    },
    "op": {
      "enum": [
        "set_mute",
        "set_solo",
        "set_record_armed"
      ]
    },
    "value": {
      "type": "boolean"
    },
    "changed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "nativeInvoked": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "verification": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "by",
        "requestedValue",
        "audioSideValue",
        "observedAt"
      ],
      "properties": {
        "by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "model",
              "audio_copy"
            ]
          }
        },
        "requestedValue": {
          "type": "boolean"
        },
        "audioSideValue": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "muteContext": {
          "$ref": "#/$defs/muteContext"
        }
      }
    },
    "observedChanges": {
      "type": "array",
      "maxItems": 818,
      "items": {
        "type": "object",
        "required": [
          "projectId",
          "path",
          "before",
          "after"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "trackId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "path": {
            "type": "string"
          },
          "before": {
            "type": [
              "boolean",
              "string",
              "null"
            ]
          },
          "after": {
            "type": [
              "boolean",
              "string",
              "null"
            ]
          },
          "muteContext": {
            "$ref": "#/$defs/muteContext"
          }
        }
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "required": [
            "execution"
          ]
        }
      }
    },
    "muteScope": {
      "enum": [
        "global",
        "sequence"
      ]
    },
    "sequence": {
      "oneOf": [
        {
          "$ref": "#/$defs/sequenceRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "timing": {
      "type": "object",
      "description": "Monotonic durations in milliseconds except cumulative UI work in microseconds; no sample or acoustic timing guarantee. Null means the stage has not completed.",
      "required": [
        "queueMs",
        "dispatchMs",
        "verificationMs",
        "totalMs",
        "uiWorkUs",
        "verificationPasses"
      ],
      "properties": {
        "queueMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "dispatchMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "verificationMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "totalMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "uiWorkUs": {
          "type": "integer",
          "minimum": 0
        },
        "verificationPasses": {
          "type": "integer",
          "minimum": 0
        },
        "maxUiCallbackUs": {
          "type": "integer",
          "minimum": 0
        },
        "stagesUs": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "verificationUiUs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "observationCoverage": {
      "type": "object",
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "kind",
            "offset",
            "count",
            "totalTracks",
            "topologyEpoch",
            "durationUs"
          ],
          "properties": {
            "kind": {
              "const": "user_track_flags"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 136
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 136
            },
            "totalTracks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 136
            },
            "topologyEpoch": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "durationUs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "after": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "kind",
            "offset",
            "count",
            "totalTracks",
            "topologyEpoch",
            "durationUs"
          ],
          "properties": {
            "kind": {
              "const": "user_track_flags"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 136
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 136
            },
            "totalTracks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 136
            },
            "topologyEpoch": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "durationUs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "applied"
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "const": "completed"
          },
          "changed": {
            "type": "boolean"
          },
          "error": {
            "type": "null"
          },
          "verification": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "const": "not_started"
          },
          "nativeInvoked": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "set_mute"
          }
        }
      },
      "then": {
        "required": [
          "muteScope",
          "sequence"
        ],
        "if": {
          "properties": {
            "muteScope": {
              "const": "sequence"
            }
          }
        },
        "then": {
          "properties": {
            "sequence": {
              "$ref": "#/$defs/sequenceRef"
            }
          }
        },
        "else": {
          "properties": {
            "sequence": {
              "type": "null"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sequenceRef": {
      "type": "object",
      "required": [
        "instanceId",
        "projectId",
        "sequenceId",
        "generation"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        "projectId": {
          "type": "string",
          "maxLength": 20,
          "description": "Nonzero uint64, at most 18446744073709551615",
          "pattern": "^[1-9][0-9]*$"
        },
        "sequenceId": {
          "type": "string",
          "maxLength": 20,
          "description": "Nonzero uint64, at most 18446744073709551615",
          "pattern": "^[1-9][0-9]*$"
        },
        "generation": {
          "type": "string",
          "maxLength": 20,
          "description": "Nonzero uint64, at most 18446744073709551615",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "additionalProperties": false
    },
    "muteContext": {
      "type": "object",
      "required": [
        "scope",
        "sequence"
      ],
      "properties": {
        "scope": {
          "enum": [
            "global",
            "sequence",
            null
          ]
        },
        "sequence": {
          "oneOf": [
            {
              "$ref": "#/$defs/sequenceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "sequence"
              }
            }
          },
          "then": {
            "properties": {
              "sequence": {
                "$ref": "#/$defs/sequenceRef"
              }
            }
          },
          "else": {
            "properties": {
              "sequence": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "description": "Applied verifies required live observations at completion; later automation may change the flag. Read mute/solo writes use AUTOMATION_READ_NOOP_ONLY. Write/unknown modes use AUTOMATION_UNQUALIFIED."
}

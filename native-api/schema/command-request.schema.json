{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MPC native API 0.1 Unix flag command request",
  "type": "object",
  "required": [
    "apiVersion",
    "op",
    "requestId",
    "target",
    "value"
  ],
  "properties": {
    "apiVersion": {
      "const": "0.1"
    },
    "op": {
      "enum": [
        "set_mute",
        "set_solo",
        "set_record_armed"
      ]
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "target": {
      "type": "object",
      "required": [
        "instanceId",
        "projectId",
        "trackId"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        "projectId": {
          "type": "string",
          "maxLength": 20,
          "description": "Nonzero unsigned 64-bit incarnation ID, at most 18446744073709551615",
          "pattern": "^[1-9][0-9]*$"
        },
        "trackId": {
          "type": "string",
          "maxLength": 20,
          "description": "Nonzero unsigned 64-bit incarnation ID, at most 18446744073709551615",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "additionalProperties": false
    },
    "value": {
      "type": "boolean"
    },
    "expected": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "startWithinMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000,
      "default": 1000
    },
    "waitMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30000
    },
    "muteScope": {
      "enum": [
        "global",
        "sequence"
      ],
      "default": "global"
    },
    "sequence": {
      "type": "object",
      "required": [
        "instanceId",
        "projectId",
        "sequenceId",
        "generation"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        "projectId": {
          "type": "string",
          "maxLength": 20,
          "description": "Nonzero uint64, at most 18446744073709551615",
          "pattern": "^[1-9][0-9]*$"
        },
        "sequenceId": {
          "type": "string",
          "maxLength": 20,
          "description": "Nonzero uint64, at most 18446744073709551615",
          "pattern": "^[1-9][0-9]*$"
        },
        "generation": {
          "type": "string",
          "maxLength": 20,
          "description": "Nonzero uint64, at most 18446744073709551615",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "const": "set_mute"
          }
        }
      },
      "then": {
        "if": {
          "required": [
            "muteScope"
          ],
          "properties": {
            "muteScope": {
              "const": "sequence"
            }
          }
        },
        "then": {
          "required": [
            "sequence"
          ]
        },
        "else": {
          "not": {
            "required": [
              "sequence"
            ]
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "muteScope"
              ]
            },
            {
              "required": [
                "sequence"
              ]
            }
          ]
        }
      }
    }
  ]
}

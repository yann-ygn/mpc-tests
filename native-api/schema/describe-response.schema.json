{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MPC native API 0.1 describe response or protocol error",
  "oneOf": [
    {
      "$ref": "#/$defs/description"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "flagSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "readableFields",
        "unsupportedReasons",
        "operations",
        "outputVerified"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "readableFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unsupportedReasons": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "set_mute",
            "set_solo",
            "set_record_armed"
          ],
          "properties": {
            "set_mute": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "available",
                "reason",
                "verification",
                "conditions"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "automation": {
                  "$ref": "#/$defs/automationQualification"
                },
                "verification": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "model",
                      "audio_copy"
                    ]
                  }
                },
                "conditions": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "available": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "reason": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            },
            "set_solo": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "available",
                "reason",
                "verification",
                "conditions"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "automation": {
                  "$ref": "#/$defs/automationQualification"
                },
                "verification": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "model",
                      "audio_copy"
                    ]
                  }
                },
                "conditions": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "available": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "reason": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            },
            "set_record_armed": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "available",
                "reason",
                "verification",
                "conditions"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "automation": {
                  "$ref": "#/$defs/automationQualification"
                },
                "verification": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "model",
                      "audio_copy"
                    ]
                  }
                },
                "conditions": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "available": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "reason": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "outputVerified": {
          "const": false
        }
      }
    },
    "capability": {
      "type": "object",
      "required": [
        "available",
        "reason"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "trackTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "model",
              "audio_copy"
            ]
          }
        },
        "screens": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "automation": {
          "$ref": "#/$defs/automationQualification"
        },
        "muteScopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "global",
              "sequence"
            ]
          }
        },
        "inactiveSequence": {
          "const": "SEQUENCE_NOT_ACTIVE"
        },
        "muteReadCoverage": {
          "const": "active_sequence"
        },
        "transportStates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "stopped",
              "sequence_playback"
            ]
          }
        },
        "excludedContexts": {
          "type": "object",
          "properties": {
            "recording": {
              "const": "RECORDING_UNQUALIFIED"
            },
            "overdub": {
              "const": "RECORDING_UNQUALIFIED"
            },
            "automationWriteUnknown": {
              "const": "AUTOMATION_UNQUALIFIED"
            },
            "clipSong": {
              "const": "PLAYBACK_CONTEXT_UNQUALIFIED"
            }
          },
          "additionalProperties": false
        },
        "timingSemantics": {
          "const": "immediate_model_at_ui_dispatch"
        },
        "sampleAccurate": {
          "const": false
        },
        "quantizedScheduling": {
          "const": false
        },
        "scope": {
          "const": "global"
        },
        "unit": {
          "enum": [
            "normalized",
            "boolean"
          ]
        },
        "minimum": {
          "const": 0
        },
        "maximum": {
          "const": 1
        },
        "centre": {
          "const": 0.5
        },
        "indexBase": {
          "const": 0
        },
        "indexCount": {
          "const": 4
        },
        "requiresMixerGeneration": {
          "const": true
        },
        "quantization": {
          "const": "ieee_binary32"
        },
        "expectedComparison": {
          "const": "binary32_exact"
        },
        "busWrites": {
          "const": false
        },
        "audioCompletionKnown": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "automationQualification": {
      "type": "object",
      "required": [
        "off",
        "read",
        "write",
        "unknown"
      ],
      "additionalProperties": false,
      "properties": {
        "off": {
          "const": "qualified_writes"
        },
        "read": {
          "enum": [
            "qualified_writes",
            "verified_noop_only",
            "unsupported"
          ]
        },
        "write": {
          "const": "unsupported"
        },
        "unknown": {
          "const": "unsupported"
        },
        "readBehavior": {
          "enum": [
            "manual_change_until_native_update",
            "native_record_arm",
            "unsupported"
          ]
        },
        "readConditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "qualified_native_sources",
              "stable_active_sequence",
              "solo_peers_off_or_read",
              "sequence_mute_active_clip"
            ]
          }
        },
        "timelineEdits": {
          "const": false
        }
      }
    },
    "nullableMilliseconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "description": {
      "type": "object",
      "required": [
        "apiVersion",
        "deviceId",
        "instanceId",
        "implementation",
        "firmware",
        "readiness",
        "readableFields",
        "capabilities",
        "limits",
        "flagFamilies",
        "instrumentIdentity"
      ],
      "properties": {
        "apiVersion": {
          "const": "0.1"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "instanceId": {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        "implementation": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "firmware": {
          "type": "object",
          "required": [
            "model",
            "modelSource",
            "version",
            "versionSource",
            "buildId",
            "buildIdSource"
          ],
          "properties": {
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "modelSource": {
              "enum": [
                "device_tree",
                null
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "versionSource": {
              "enum": [
                "build_profile",
                null
              ]
            },
            "buildId": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(?:[0-9a-f]{2}){1,64}$"
            },
            "buildIdSource": {
              "enum": [
                "elf_note",
                null
              ]
            }
          }
        },
        "readiness": {
          "type": "object",
          "required": [
            "status",
            "nativeAdapter",
            "mpcProcess",
            "firmwareProfile",
            "profileId"
          ],
          "properties": {
            "status": {
              "enum": [
                "discovery_only",
                "ready",
                "not_ready"
              ]
            },
            "nativeAdapter": {
              "enum": [
                "not_attached",
                "attached"
              ]
            },
            "adapter": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "abiVersion",
                "instanceId",
                "codeVerified",
                "qualification"
              ],
              "properties": {
                "abiVersion": {
                  "const": 2
                },
                "instanceId": {
                  "type": "string",
                  "pattern": "^adp_[0-9a-f]{32}$"
                },
                "codeVerified": {
                  "const": true
                },
                "qualification": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "mpcProcess": {
              "enum": [
                "running",
                "not_running",
                "ambiguous",
                "unreadable"
              ]
            },
            "firmwareProfile": {
              "enum": [
                "matched",
                "unsupported",
                "unknown"
              ]
            },
            "profileId": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "readableFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "flagFamilies": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/flagSupport"
          }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "describe",
            "get_state",
            "current_track",
            "set_mute",
            "set_solo",
            "set_record_armed",
            "get_command",
            "watch",
            "set_volume",
            "set_pan",
            "set_send_level",
            "set_insert_rack_enabled",
            "set_insert_enabled",
            "set_track_colour",
            "set_track_transpose",
            "set_track_velocity_scale",
            "set_midi_output_channel",
            "set_midi_bank_enabled",
            "set_midi_bank_msb",
            "set_midi_bank_lsb",
            "set_midi_program_enabled",
            "set_midi_program",
            "rename_track",
            "create_track",
            "copy_track",
            "remove_track",
            "set_midi_input_port",
            "set_midi_output_port",
            "set_midi_input_channel",
            "set_cv_port",
            "set_gate_port"
          ],
          "properties": {
            "describe": {
              "allOf": [
                {
                  "$ref": "#/$defs/capability"
                },
                {
                  "properties": {
                    "available": {
                      "const": true
                    }
                  }
                }
              ]
            },
            "get_state": {
              "$ref": "#/$defs/capability"
            },
            "current_track": {
              "$ref": "#/$defs/capability"
            },
            "set_mute": {
              "$ref": "#/$defs/capability"
            },
            "set_solo": {
              "$ref": "#/$defs/capability"
            },
            "set_record_armed": {
              "$ref": "#/$defs/capability"
            },
            "get_command": {
              "$ref": "#/$defs/capability"
            },
            "watch": {
              "$ref": "#/$defs/watchCapability"
            },
            "set_volume": {
              "$ref": "#/$defs/capability"
            },
            "set_pan": {
              "$ref": "#/$defs/capability"
            },
            "set_send_level": {
              "$ref": "#/$defs/capability"
            },
            "set_insert_rack_enabled": {
              "$ref": "#/$defs/capability"
            },
            "set_insert_enabled": {
              "$ref": "#/$defs/capability"
            },
            "play": {
              "$ref": "#/$defs/navigationCapability"
            },
            "stop": {
              "$ref": "#/$defs/navigationCapability"
            },
            "play_start": {
              "$ref": "#/$defs/navigationCapability"
            },
            "locate": {
              "$ref": "#/$defs/navigationCapability"
            },
            "select_track": {
              "$ref": "#/$defs/navigationCapability"
            },
            "select_sequence": {
              "$ref": "#/$defs/navigationCapability"
            },
            "set_sequence_bpm": {
              "$ref": "#/$defs/navigationCapability"
            },
            "set_track_colour": {
              "$ref": "#/$defs/trackSetupCapability"
            },
            "set_track_transpose": {
              "$ref": "#/$defs/trackSetupCapability"
            },
            "set_track_velocity_scale": {
              "$ref": "#/$defs/trackSetupCapability"
            },
            "set_midi_output_channel": {
              "$ref": "#/$defs/trackSetupCapability"
            },
            "set_midi_bank_enabled": {
              "$ref": "#/$defs/trackSetupCapability"
            },
            "set_midi_bank_msb": {
              "$ref": "#/$defs/trackSetupCapability"
            },
            "set_midi_bank_lsb": {
              "$ref": "#/$defs/trackSetupCapability"
            },
            "set_midi_program_enabled": {
              "$ref": "#/$defs/trackSetupCapability"
            },
            "set_midi_program": {
              "$ref": "#/$defs/trackSetupCapability"
            },
            "rename_track": {
              "$ref": "#/$defs/capability"
            },
            "create_track": {
              "$ref": "#/$defs/capability"
            },
            "copy_track": {
              "$ref": "#/$defs/capability"
            },
            "remove_track": {
              "$ref": "#/$defs/capability"
            },
            "set_midi_input_port": {
              "$ref": "#/$defs/capability"
            },
            "set_midi_output_port": {
              "$ref": "#/$defs/capability"
            },
            "set_midi_input_channel": {
              "$ref": "#/$defs/capability"
            },
            "set_cv_port": {
              "$ref": "#/$defs/capability"
            },
            "set_gate_port": {
              "$ref": "#/$defs/capability"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/capability"
          }
        },
        "limits": {
          "type": "object",
          "required": [
            "maxRequestBytes",
            "maxResponseBytes",
            "maxConnections",
            "connectionTimeoutMs",
            "queueCapacity",
            "requestRetentionMs",
            "defaultStartWithinMs",
            "maxStartWithinMs",
            "verificationTimeoutMs",
            "maxTracks",
            "maxMidiTracks",
            "maxAudioTracks",
            "maxBuses",
            "snapshotAbiVersion"
          ],
          "properties": {
            "maxRequestBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxResponseBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxConnections": {
              "type": "integer",
              "minimum": 1
            },
            "connectionTimeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "queueCapacity": {
              "type": "integer",
              "minimum": 0
            },
            "receiptCapacity": {
              "type": "integer",
              "minimum": 0
            },
            "requestRetentionMs": {
              "type": "integer",
              "minimum": 0
            },
            "defaultStartWithinMs": {
              "$ref": "#/$defs/nullableMilliseconds"
            },
            "maxStartWithinMs": {
              "$ref": "#/$defs/nullableMilliseconds"
            },
            "maxWaitMs": {
              "$ref": "#/$defs/nullableMilliseconds"
            },
            "verificationTimeoutMs": {
              "$ref": "#/$defs/nullableMilliseconds"
            },
            "adapterProbeTimeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "maxTracks": {
              "const": 136
            },
            "maxMidiTracks": {
              "const": 128
            },
            "maxAudioTracks": {
              "const": 8
            },
            "maxBuses": {
              "const": 128
            },
            "snapshotAbiVersion": {
              "const": 8
            },
            "maxJobsPerUiCallback": {
              "enum": [
                1,
                null
              ]
            }
          }
        },
        "instrumentIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason",
            "trackTypes",
            "formats",
            "fields",
            "instanceIdentity",
            "presets",
            "parameters",
            "productIdScope"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "trackTypes": {
              "const": [
                "plugin"
              ]
            },
            "formats": {
              "const": [
                "MPC"
              ]
            },
            "fields": {
              "const": [
                "displayName",
                "productId"
              ]
            },
            "instanceIdentity": {
              "const": false
            },
            "presets": {
              "const": false
            },
            "parameters": {
              "const": false
            },
            "productIdScope": {
              "const": "native_format_catalog"
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "apiVersion",
        "error"
      ],
      "properties": {
        "apiVersion": {
          "const": "0.1"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object"
            }
          }
        }
      }
    },
    "watchCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "reason",
        "maxSubscribers",
        "replayCapacity",
        "replayBytes",
        "replayRetentionMs",
        "sampleIntervalMs",
        "samplePageTracks",
        "metadataAuditMs",
        "heartbeatMs",
        "testedTracks",
        "maximumDensityQualified"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "maxSubscribers": {
          "const": 8
        },
        "replayCapacity": {
          "const": 64
        },
        "replayBytes": {
          "const": 4194304
        },
        "replayRetentionMs": {
          "const": 30000
        },
        "sampleIntervalMs": {
          "const": 100
        },
        "samplePageTracks": {
          "const": 16
        },
        "metadataAuditMs": {
          "const": 5000
        },
        "heartbeatMs": {
          "const": 1000
        },
        "testedTracks": {
          "const": 8
        },
        "maximumDensityQualified": {
          "const": false
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/capability"
        }
      ]
    },
    "navigationCapability": {
      "type": "object",
      "required": [
        "available",
        "reason",
        "verification",
        "conditions",
        "viewIndependent",
        "requestReplay"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification": {
          "const": [
            "model"
          ]
        },
        "viewIndependent": {
          "const": true
        },
        "requestReplay": {
          "const": "retained_result"
        },
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "sampleAccurate": {
          "const": false
        },
        "quantizedScheduling": {
          "const": false
        },
        "queuedSelection": {
          "const": false
        },

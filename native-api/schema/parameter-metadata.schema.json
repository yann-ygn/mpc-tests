{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mpc-api.local/schema/parameter-metadata.schema.json",
  "title": "Research-only native program parameter metadata v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "metadataVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "firmware": {
      "type": "object",
      "properties": {
        "model": {
          "const": "Akai Professional MPC Key 37"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "buildId": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "model",
        "version",
        "buildId"
      ],
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "properties": {
        "available": {
          "const": false
        },
        "reason": {
          "const": "RESEARCH_ONLY"
        },
        "publicOperation": {
          "type": "null"
        },
        "labOnly": {
          "const": true
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "required": [
        "available",
        "reason",
        "publicOperation",
        "labOnly",
        "conditions"
      ],
      "additionalProperties": false
    },
    "abi": {
      "type": "object",
      "properties": {
        "getter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "setter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "floatAbi": {
          "const": "armhf"
        },
        "receiver": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "notifications": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "undo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "getter",
        "setter",
        "floatAbi",
        "receiver",
        "notifications",
        "undo"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "drumVtable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "instrumentVtable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "instruments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "realtimeParameters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "layers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "layerStride": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "drumVtable",
        "instrumentVtable",
        "instruments",
        "realtimeParameters",
        "layers",
        "layerStride"
      ],
      "additionalProperties": false
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]+$"
          },
          "rva": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "prefixHex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "rva",
          "prefixHex"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^k[A-Za-z0-9_]+$"
          },
          "nativeId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "classification": {
            "enum": [
              "native_control",
              "candidate",
              "enum_only",
              "unused_identifier",
              "legacy_identifier",
              "unsupported_family"
            ]
          },
          "families": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "drum",
                "keygroup",
                "plugin",
                "cv",
                "audio",
                "midi"
              ]
            }
          },
          "qualification": {
            "enum": [
              "device_verified",
              "unverified"
            ]
          },
          "publicRead": {
            "const": false
          },
          "publicWrite": {
            "const": false
          },
          "value": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "number"
                  },
                  "minimum": {
                    "type": "number"
                  },
                  "maximum": {
                    "type": "number"
                  },
                  "unit": {
                    "const": "normalized"
                  },
                  "nativeType": {
                    "enum": [
                      "float",
                      "int"
                    ]
                  },
                  "nativeUnit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "nativeScale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "nativeBias": {
                    "type": "number"
                  },
                  "getterCanonicalization": {
                    "enum": [
                      "none",
                      "binary32_endpoint_clamp"
                    ]
                  },
                  "quantization": {
                    "enum": [
                      "binary32",
                      "integer_semitones"
                    ]
                  }
                },
                "required": [
                  "type",
                  "minimum",
                  "maximum",
                  "unit",
                  "nativeType",
                  "nativeUnit",
                  "nativeScale",
                  "nativeBias",
                  "getterCanonicalization",
                  "quantization"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "index": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "pad"
                  },
                  "minimum": {
                    "const": 0
                  },
                  "maximum": {
                    "const": 0
                  },
                  "layer": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 7
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "minimum",
                  "maximum",
                  "layer"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "readback": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "owner": {
                    "enum": [
                      "realtime",
                      "layer"
                    ]
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                },
                "required": [
                  "owner",
                  "offset"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "static": {
                "const": true
              },
              "device": {
                "type": "boolean"
              },
              "notes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "static",
              "device",
              "notes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "key",
          "nativeId",
          "classification",
          "families",
          "qualification",
          "publicRead",
          "publicWrite",
          "value",
          "index",
          "readback",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "separatePaths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "plugin",
              "insert_effect"
            ]
          },
          "available": {
            "const": false
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "kind",
          "available",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "metadataVersion",
    "firmware",
    "capability",
    "abi",
    "layout",
    "functions",
    "parameters",
    "separatePaths"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MPC native API snapshot responses",
  "type": "object",
  "required": [
    "apiVersion",
    "deviceId",
    "instanceId",
    "projectId",
    "projectGeneration",
    "revision",
    "sample",
    "unsupportedFields",
    "muteContext"
  ],
  "properties": {
    "apiVersion": {
      "const": "0.1"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1
    },
    "instanceId": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{32}$"
    },
    "projectId": {
      "type": [
        "string",
        "null"
      ]
    },
    "projectGeneration": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "sample": {
      "type": "object",
      "required": [
        "startedAt",
        "finishedAt",
        "durationMs",
        "attempts",
        "atomic",
        "consistency",
        "freshness",
        "source"
      ],
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "atomic": {
          "const": false
        },
        "consistency": {
          "const": "identity_topology_selection_checked"
        },
        "freshness": {
          "const": "fresh"
        },
        "source": {
          "const": "native_ui_thread"
        }
      }
    },
    "tracks": {
      "type": "array",
      "maxItems": 136,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "buses": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "track": {
      "$ref": "#/$defs/track"
    },
    "sequence": {
      "$ref": "#/$defs/sequence"
    },
    "sequences": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/sequence"
      }
    },
    "selectedSequence": {
      "$ref": "#/$defs/sequence"
    },
    "sequenceSlotCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "usedSequenceCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "unsupportedFields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "muteContext": {
      "$ref": "#/$defs/muteContext"
    },
    "transport": {
      "type": "object",
      "required": [
        "playing",
        "recording",
        "recordMode",
        "pulse",
        "sequenceBpm",
        "masterBpm",
        "masterTempoEnabled",
        "effectiveBpm",
        "tempoSource",
        "queuedSequenceId"
      ],
      "additionalProperties": false,
      "properties": {
        "playing": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "recording": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "recordMode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "pulse": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "sequenceBpm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 20,
          "maximum": 999
        },
        "masterBpm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 20,
          "maximum": 999
        },
        "masterTempoEnabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "effectiveBpm": {
          "type": "null"
        },
        "tempoSource": {
          "type": "null"
        },
        "queuedSequenceId": {
          "type": "null"
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "tracks",
        "buses"
      ]
    },
    {
      "required": [
        "track"
      ]
    },
    {
      "required": [
        "sequence"
      ]
    }
  ],
  "$defs": {
    "track": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "ref",
        "generation",
        "kind",
        "index",
        "name",
        "type",
        "requested",
        "audioSide",
        "silenced",
        "unsupportedFields",
        "uiIndex",
        "collection",
        "flagSupport",
        "mixer",
        "setup"
      ],
      "properties": {
        "ref": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "instanceId",
            "projectId",
            "trackId"
          ],
          "properties": {
            "instanceId": {
              "type": "string",
              "minLength": 1
            },
            "projectId": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "trackId": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "generation": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "track",
            "bus"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested": {
          "type": "object",
          "required": [
            "muted",
            "soloed",
            "recordArmed"
          ],
          "properties": {
            "muted": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Live Program mute in the response muteContext; only the active sequence is covered when sequence scope is enabled. Other scope values are unavailable."
            },
            "soloed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "recordArmed": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "audioSide": {
          "type": "object",
          "required": [
            "muted",
            "soloed",
            "recordArmed"
          ],
          "properties": {
            "muted": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "soloed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "recordArmed": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "silenced": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "unsupportedFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uiIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 135
        },
        "collection": {
          "enum": [
            "midi_triggered",
            "audio",
            "master"
          ]
        },
        "flagSupport": {
          "$ref": "#/$defs/flagSupport"
        },
        "mixer": {
          "$ref": "#/$defs/mixer"
        },
        "setup": {
          "type": "object",
          "required": [
            "colour",
            "transposeSemitones",
            "velocityScale",
            "midiOutputChannel",
            "midiBankEnabled",
            "midiBankMsb",
            "midiBankLsb",
            "midiProgramEnabled",
            "midiProgram"
          ],
          "properties": {
            "colour": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 16777215
            },
            "transposeSemitones": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": -24,
              "maximum": 24
            },
            "velocityScale": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0.009999999776482582,
              "maximum": 2
            },
            "midiOutputChannel": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 16
            },
            "midiBankEnabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "midiBankMsb": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 127
            },
            "midiBankLsb": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 127
            },
            "midiProgramEnabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "midiProgram": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 127
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "track"
              }
            }
          },
          "then": {
            "properties": {
              "uiIndex": {
                "type": "integer"
              },
              "collection": {
                "enum": [
                  "midi_triggered",
                  "audio"
                ]
              },
              "ref": {
                "type": "object"
              },
              "generation": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "uiIndex": {
                "type": "null"
              },
              "collection": {
                "const": "master"
              },
              "ref": {
                "type": "null"
              },
              "generation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "sequence": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "generation",
        "index",
        "name",
        "used",
        "bpm",
        "bpmSource",
        "ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "used": {
          "type": "boolean"
        },
        "bpm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bpmSource": {
          "const": "sequence_property"
        },
        "ref": {
          "$ref": "#/$defs/sequenceRef"
        }
      }
    },
    "sequenceRef": {
      "type": "object",
      "required": [
        "instanceId",
        "projectId",
        "sequenceId",
        "generation"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        "projectId": {
          "type": "string",
          "maxLength": 20,
          "description": "Nonzero uint64, at most 18446744073709551615",
          "pattern": "^[1-9][0-9]*$"
        },
        "sequenceId": {
          "type": "string",
          "maxLength": 20,
          "description": "Nonzero uint64, at most 18446744073709551615",
          "pattern": "^[1-9][0-9]*$"
        },
        "generation": {
          "type": "string",
          "maxLength": 20,
          "description": "Nonzero uint64, at most 18446744073709551615",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "additionalProperties": false
    },
    "muteContext": {
      "type": "object",
      "required": [
        "scope",
        "sequence"
      ],
      "properties": {
        "scope": {
          "enum": [
            "global",
            "sequence",
            null
          ]
        },
        "sequence": {
          "oneOf": [
            {
              "$ref": "#/$defs/sequenceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "sequence"
              }
            }
          },
          "then": {
            "properties": {
              "sequence": {
                "$ref": "#/$defs/sequenceRef"
              }
            }
          },
          "else": {
            "properties": {
              "sequence": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "flagSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "readableFields",
        "unsupportedReasons",
        "operations",
        "outputVerified"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "readableFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unsupportedReasons": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "set_mute",
            "set_solo",
            "set_record_armed"
          ],
          "properties": {
            "set_mute": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "available",
                "reason",
                "verification",
                "conditions"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "verification": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "model",
                      "audio_copy"
                    ]
                  }
                },
                "conditions": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "automation": {
                  "$ref": "#/$defs/automationQualification"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "available": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "reason": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            },
            "set_solo": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "available",
                "reason",
                "verification",
                "conditions"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "verification": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "model",
                      "audio_copy"
                    ]
                  }
                },
                "conditions": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "automation": {
                  "$ref": "#/$defs/automationQualification"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "available": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "reason": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            },
            "set_record_armed": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "available",
                "reason",
                "verification",
                "conditions"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "verification": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "model",
                      "audio_copy"
                    ]
                  }
                },
                "conditions": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "automation": {
                  "$ref": "#/$defs/automationQualification"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "available": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "reason": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "outputVerified": {
          "const": false
        }
      }
    },
    "automationQualification": {
      "type": "object",
      "required": [
        "off",
        "read",
        "write",
        "unknown"
      ],
      "additionalProperties": false,
      "properties": {
        "off": {
          "const": "qualified_writes"
        },
        "read": {
          "enum": [
            "qualified_writes",
            "verified_noop_only",
            "unsupported"
          ]
        },
        "write": {
          "const": "unsupported"
        },
        "unknown": {
          "const": "unsupported"
        },
        "readBehavior": {
          "enum": [
            "manual_change_until_native_update",
            "native_record_arm",
            "unsupported"
          ]
        },
        "readConditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "qualified_native_sources",
              "stable_active_sequence",
              "solo_peers_off_or_read",
              "sequence_mute_active_clip"
            ]
          }
        },
        "timelineEdits": {
          "const": false
        }
      }
    },
    "mixer": {
      "type": "object",
      "required": [
        "generation",
        "known",
        "scope",
        "unit",
        "volume",
        "pan",
        "sends",
        "insertRackEnabled",
        "inserts",
        "verification",
        "audioCompletionKnown"
      ],
      "properties": {
        "generation": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 20
            },
            {
              "type": "null"
            }
          ]
        },
        "known": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2047
        },
        "scope": {
          "const": "global"
        },
        "unit": {
          "const": "normalized"
        },
        "volume": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "pan": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "sends": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "index",
              "destination",
              "value"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "destination": {
                "enum": [
                  "return_A",
                  "return_B",
                  "return_C",
                  "return_D"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "insertRackEnabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "inserts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "index",
              "occupied",
              "enabled"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "occupied": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "enabled": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "verification": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "const": "model"
          }
        },
        "audioCompletionKnown": {
          "const": false
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "set_volume",
            "set_pan",
            "set_send_level",
            "set_insert_rack_enabled",
            "set_insert_enabled"
          ],
          "properties": {
            "set_volume": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "available",
                "automation"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "automation": {
                  "$ref": "#/$defs/automationQualification"
                }
              }
            },
            "set_pan": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "available",
                "automation"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "automation": {
                  "$ref": "#/$defs/automationQualification"
                }
              }
            },
            "set_send_level": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "available",
                "automation"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "automation": {
                  "$ref": "#/$defs/automationQualification"
                }
              }
            },
            "set_insert_rack_enabled": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "available",
                "automation"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "automation": {
                  "$ref": "#/$defs/automationQualification"
                }
              }
            },
            "set_insert_enabled": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "available",
                "automation"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "automation": {
